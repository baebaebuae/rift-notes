lishName":"Sion","positions":["TOP"],"source":"https://ddragon.leagueoflegends.com/cdn/16.22.1/data/ko_KR/champion/Sion.json","formulaSource":"https://cdn.merakianalytics.com/riot/lol/resources/latest/en-US/champions.json","attackDamageGrowth":{"value":4,"source":"https://cdn.merakianalytics.com/riot/lol/resources/latest/en-US/champions.json","sourcePatch":"15.15.1","method":"보관본 및 이후 공식 능력치 변경 반영"},"details":{"version":"16.22.1","patch":"26.22","reviewedAt":"2026-11-07","skills":{"P":{"status":"reconciled","notes":"","sources":[{"patch":"25.16","date":"2025-08-12","url":"https://www.leagueoflegends.com/en-us/news/game-updates/patch-25-16-notes/#patch-sion"}],"effects":["기본 지속 효과: 치명적인 피해를 받으면 1.5초 동안 경직된 뒤 광란 상태로 되살아나 최대 체력의 100%를 회복합니다. 이후 0.264초마다 2~19(레벨에 따라)의 체력을 잃으며, 매번 잃는 체력이 초기 감소량의 70%, 즉 1.4~13.3(레벨에 따라)씩 증가합니다. 이 동안 체력 재생과 생명력 흡수를 제외한 모든 회복 효과의 효율은 0%가 됩니다.","이 상태에서는 이동, 기본 공격, 아이템 사용 효과만 사용할 수 있으며 다음 효과를 얻습니다. 공격 속도의 최솟값과 최댓값이 1.75가 됩니다. 생명력 흡수가 100%가 됩니다. 기본 공격 적중 시 대상 최대 체력의 10%에 해당하는 추가 물리 피해를 입히며, 챔피언이 아닌 대상에게는 최대 75입니다. 유닛을 통과할 수 있습니다. 모든 스킬이 죽음의 물결로 바뀌며 한 번 사용할 수 있습니다.","영광스러운 죽음 상태에서 구조물에게 입히는 피해량은 40%로 감소합니다.","사용 효과: 67%의 추가 이동 속도를 얻으며, 2.376초에 걸쳐 감소합니다. 스킬을 하나 이상 배웠다면 아직 배우지 않은 스킬을 포함해 어떤 스킬 키로도 죽음의 물결을 사용할 수 있습니다."],"rows":[]},"Q":{"status":"reconciled","notes":"","sources":[{"patch":"26.13","date":"2026-06-23","url":"https://www.leagueoflegends.com/en-us/news/game-updates/league-of-legends-patch-26-13-notes/#patch-sion"},{"patch":"25.23","date":"2025-11-18","url":"https://www.leagueoflegends.com/en-us/news/game-updates/patch-25-23-notes/#patch-sion"}],"effects":[],"rows":[{"attribute":"최소 물리 피해량","value":"30 / 45 / 60 / 75 / 90 + 40 / 50 / 60 / 70 / 80% AD","provenance":"derived","sources":[{"patch":"26.13","date":"2026-06-23","url":"https://www.leagueoflegends.com/en-us/news/game-updates/league-of-legends-patch-26-13-notes/#patch-sion"}]},{"attribute":"최대 물리 피해량","value":"90 / 155 / 220 / 285 / 350 + 120 / 150 / 180 / 210 / 240% AD","provena
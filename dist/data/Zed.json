champion","x":336,"y":48,"w":48,"h":48},"version":"16.22.1","formulas":[{"slot":"P","variants":[{"name":"Contempt for the Weak","rows":[],"damageType":"MAGIC_DAMAGE","effects":["Innate: Zed's basic attacks against targets below 50% maximum health are empowered to deal 6% / 8% / 10% (based on level) of the target's maximum health as bonus magic damage.","Against monsters, Contempt for the Weak deals 200% damage, capped at 300.","Contempt for the Weak cannot occur on the same champion more than once every few seconds."]}]},{"slot":"Q","variants":[{"name":"Razor Shuriken","rows":[{"attribute":"Physical Damage","modifiers":[{"values":[80,120,160,200,240],"units":["","","","",""]},{"values":[100,100,100,100,100],"units":["% bonus AD","% bonus AD","% bonus AD","% bonus AD","% bonus AD"]}]},{"attribute":"Reduced Damage","modifiers":[{"values":[48,72,96,120,144],"units":["","","","",""]},{"values":[60,60,60,60,60],"units":["% bonus AD","% bonus AD","% bonus AD","% bonus AD","% bonus AD"]}]}],"damageType":"PHYSICAL_DAMAGE","effects":[]}]},{"slot":"W","variants":[{"name":"Living Shadow","rows":[{"attribute":"Energy Restored","modifiers":[{"values":[30,35,40,45,50],"units":["","","","",""]}]}],"damageType":null,"effects":["Active: Zed creates a Shadow that dashes to the target location and remains there for 5.25 seconds, being able to mimic Razor Shuriken and Shadow Slash regardless of range. Living Shadow can be recast while within range of the Shadow.","Recast: Zed and the Shadow blink to swap places. If Living Shadow was recast while the Shadow is dashing, the recast will instead occur once it has been placed.","If an ability is cast while the Shadow is dashing, it will cast that ability once it has been placed. See Pets for more details about Shadows."]}]},{"slot":"E","variants":[{"name":"Shadow Slash","rows":[{"attribute":"Physical Damage","modifiers":[{"values":[70,95,120,145,170],"units":["","","","",""]},{"values":[80,80,80,80,80],"units":["% bonus AD","% bonus AD","% 
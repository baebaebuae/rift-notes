ource":"{{ abilityresourcename }} {{ cost }}"}],"info":{"attack":8,"defense":2,"magic":5,"difficulty":6},"image":{"full":"Smolder.png","sprite":"champion4.png","group":"champion","x":336,"y":0,"w":48,"h":48},"version":"16.20.1","formulas":[{"slot":"P","variants":[{"name":"Dragon Practice","rows":[],"damageType":"MAGIC_DAMAGE","effects":["Innate: Smolder generates a stack of Dragon Practice each time he hits an enemy champion with an ability, or whenever Super Scorcher Breath kills a minion or monster. His basic abilities deal bonus magic damage based on stacks.\n Super Scorcher Breath: Deals bonus magic damage equal to 40% : 70% (+ 0% : 16%) (based on critical strike chance) of Dragon Practice stacks.\n Achooo!: Explosions deal bonus magic damage equal to 55% of Dragon Practice stacks.\n Flap, Flap, Flap: Attacks each deal bonus magic damage equal to 12% of Dragon Practice stacks."]}]},{"slot":"Q","variants":[{"name":"Super Scorcher Breath","rows":[{"attribute":"Physical Damage","modifiers":[{"values":[65,80,95,110,125],"units":["","","","",""]},{"values":[130,130,130,130,130],"units":["% bonus AD","% bonus AD","% bonus AD","% bonus AD","% bonus AD"]}]},{"attribute":"Maximum Physical Damage","modifiers":[{"values":[113.75,140,166.25,192.5,218.75],"units":["","","","",""]},{"values":[227.5,227.5,227.5,227.5,227.5],"units":["% bonus AD","% bonus AD","% bonus AD","% bonus AD","% bonus AD"]}]},{"attribute":"Maximum Damage with Infinity Edge","modifiers":[{"values":[139.75,172,204.25,236.5,268.75],"units":["","","","",""]},{"values":[279.5,279.5,279.5,279.5,279.5],"units":["% bonus AD","% bonus AD","% bonus AD","% bonus AD","% bonus AD"]}]},{"attribute":"Physical Damage","modifiers":[{"values":[32.5,40,47.5,55,62.5],"units":["","","","",""]},{"values":[65,65,65,65,65],"units":["% bonus AD","% bonus AD","% bonus AD","% bonus AD","% bonus AD"]}]},{"attribute":"Maximum Physical Damage","modifiers":[{"values":[56.875,70,83.125,96.25,109.375],"units":["","","","",""]},{"values":[113.75,113.75,113.75,113.75,113.75],"units":["% bonus AD","% bonus AD","% bonus AD","% bonus AD","% bonus AD"]}]},{"attribute":"Maximum Physical Damage with Infinity Edge","modifiers":[{"values":[69.875,86,102.125,118.25,134.375],"units":["","","","",""]},{"values":[139.75,139.75,139.75,139.75,139.75],"units":["% bonus AD","% bonus AD","% bonus AD","% bonus AD","% bonus AD"]}]}],"damageType":"OTHER_DAMAGE","effects":["Super Scorcher Breath becomes empowered with new effects based on the number of Dragon Practice stacks:","Tier 1 - 25 stacks: The fireball explodes upon collision to deal the same physical damage to nearby enemies. The explosion benefits from life steal at 50% effectiveness and applies on-hit effects.","Tier 3 - 225 stacks: Enemies hit are set on fire for 3 seconds, causing them to take bonus true damage equal to[ 2.5% per 100 bonus AD (+ 0.5% per 100 Dragon Practice stacks) of their maximum health over the duration, capped at 300 against monsters. ][ 0.83% per 100 bonus AD (+ 0.17% per 100 Dragon Practice stacks) of their maximum health each second, capped at 100 per tick against monsters. ]Subsequent applications of the burn stack, though not refreshing the duration of the previous burn. Enemy champions afflicted with the burn are also executed once Smolder deals damage to them that would leave them below 6.5% of their maximum health."]}]},{"slot":"W","variants":[{"name":"Achooo!","rows":[{"attribute":"Glob Physical Damage","modifiers":[{"values":[60,70,80,90,100],"units":["","","","",""]},{"values":[60,60,60,60,60],"units":["% bonus AD","% bonus AD","% bonus AD","% bonus AD","% bonus AD"]}]},{"attribute":"Explosion Physical Damage","modifiers":[{"values":[10,35,60,85,110],"units":["","","","",""]},{"values":[65,65,65,65,65],"units":["% bonus AD","% bonus AD","% bonus AD","% bonus AD","% bonus AD"]},{"values":[80,80,80,80,80],"units":["% AP","% AP","% AP","% AP","% AP"]}]},{"attribute":"Total Physical Damage On Champion Hit","modifiers":[{"values
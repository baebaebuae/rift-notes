,"formulaSource":"https://cdn.merakianalytics.com/riot/lol/resources/latest/en-US/champions.json","attackDamageGrowth":{"value":2.75,"source":"https://cdn.merakianalytics.com/riot/lol/resources/latest/en-US/champions.json","sourcePatch":"15.15.1","method":"보관본 및 이후 공식 능력치 변경 반영"},"details":{"version":"16.22.1","patch":"26.22","reviewedAt":"2026-11-07","skills":{"P":{"status":"baseline","notes":"","sources":[],"effects":["기본 지속 효과 - 파멸: 일정 주기마다 다음 일반 스킬이 강화되어 적중한 적의 이동기를 중단시키고 0.75 / 1 / 1.25 / 1.5초(레벨에 따라) 동안 공포에 빠뜨립니다. 공포에 걸린 적은 벡스와의 거리에 따라 60%~99% 둔화됩니다. 커지는 어둠(E)이 파멸을 발동하면 적은 벡스 대신 스킬 중심에서 멀어지는 방향으로 도망칩니다. 부활하면 파멸의 재사용 대기시간이 초기화됩니다.","기본 지속 효과 - 우울: 근처 적 챔피언이나 몬스터가 돌진 또는 순간이동하면 6초 동안 우울 표식이 남습니다. 벡스의 다음 기본 공격은 투사체 없이 적중하며, 기본 공격 또는 일반 스킬이 표식 대상에게 적중하면 표식을 폭발시킵니다. 커지는 어둠(E)은 우울을 적용할 수 있지만 폭발시키지는 못합니다.","우울의 폭발은 40~150(레벨에 따라) + 주문력의 25%만큼 추가 마법 피해를 입히고 파멸의 재사용 대기시간을 25% 돌려줍니다. 챔피언이 아닌 대상에게는 대신 피해의 40% / 45% / 50% / 55% / 60%(레벨에 따라)를 입히고, 파멸의 재사용 대기시간을 10% 돌려줍니다."],"rows":[]},"Q":{"status":"baseline","notes":"","sources":[],"effects":[],"rows":[{"attribute":"마법 피해량","value":"70 / 115 / 160 / 205 / 250 + 70% AP","provenance":"baseline","sources":[]}]},"W":{"status":"baseline","notes":"","sources":[],"effects":[],"rows":[{"attribute":"보호막 흡수량","value":"50 / 75 / 100 / 125 / 150 + 75% AP","provenance":"baseline","sources":[]},{"attribute":"마법 피해량","value":"80 / 120 / 160 / 200 / 240 + 30% AP","provenance":"baseline","sources":[]}]},"E":{"status":"reconciled","notes":"","sources":[{"patch":"26.13","date":"2026-06-23","url":"https://www.leagueoflegends.com/en-us/news/game-updates/league-of-legends-patch-26-13-notes/#patch-vex"}],"effects":[],"rows":[{"attribute":"마법 피해량","value":"50 / 70 / 90 / 110 / 130 + 40 / 45 / 50 / 55 / 60% AP","provenance":"baseline","sources":[]},{"attribute":"둔화율","value":"30 / 35 / 40 / 45 / 50%","provenance":"baseline","sources":[]},{"attribute":"재사용 대기시간","value":"12초","provenance":"patch","sources":[{"patch":"26.13","date":"2026-06-23","ur
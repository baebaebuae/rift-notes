 유지됩니다."],"rows":[]},"Q":{"status":"reconciled","notes":"","sources":[{"patch":"26.1","date":"2026-01-09","url":"https://www.leagueoflegends.com/en-us/news/game-updates/patch-26-1-notes/#patch-champions"},{"patch":"26.4","date":"2026-02-18","url":"https://www.leagueoflegends.com/en-us/news/game-updates/league-of-legends-patch-26-4-notes/#patch-kayle"},{"patch":"26.22","date":"2026-11-03","url":"https://www.leagueoflegends.com/ko-kr/news/game-updates/league-of-legends-patch-26-22-notes/"}],"effects":[],"rows":[{"attribute":"재사용 대기시간","value":"10 / 9.5 / 9 / 8.5 / 8초","provenance":"patch","sources":[{"patch":"26.22","date":"2026-11-03","url":"https://www.leagueoflegends.com/ko-kr/news/game-updates/league-of-legends-patch-26-22-notes/"}]},{"attribute":"마법 피해량","value":"60 / 90 / 120 / 150 / 180 + 60% 추가 AD + 50% AP","provenance":"derived","sources":[{"patch":"26.1","date":"2026-01-09","url":"https://www.leagueoflegends.com/en-us/news/game-updates/patch-26-1-notes/#patch-champions"},{"patch":"26.4","date":"2026-02-18","url":"https://www.leagueoflegends.com/en-us/news/game-updates/league-of-legends-patch-26-4-notes/#patch-kayle"}]},{"attribute":"둔화율","value":"25 / 30 / 35 / 40 / 45%","provenance":"derived","sources":[{"patch":"26.1","date":"2026-01-09","url":"https://www.leagueoflegends.com/en-us/news/game-updates/patch-26-1-notes/#patch-champions"},{"patch":"26.4","date":"2026-02-18","url":"https://www.leagueoflegends.com/en-us/news/game-updates/league-of-legends-patch-26-4-notes/#patch-kayle"}]},{"attribute":"마나 소모량","value":"60 / 70 / 80 / 90 / 100","provenance":"patch","sources":[{"patch":"26.1","date":"2026-01-09","url":"https://www.leagueoflegends.com/en-us/news/game-updates/patch-26-1-notes/#patch-champions"}]}]},"W":{"status":"baseline","notes":"","sources":[],"effects":[],"rows":[{"attribute":"회복량","value":"55 / 80 / 105 / 130 / 155 + 25% AP","provenance":"baseline","sources":[]},{"attribute":"추가 이동 속도","value":"24 / 28 / 32 / 36 / 40% + 8% 당 100 AP","provenance
":[550,550,550],"rangeBurn":"550","image":{"full":"VolibearR.png","sprite":"spell16.png","group":"spell","x":336,"y":48,"w":48,"h":48},"resource":"{{ abilityresourcename }} {{ cost }}"}],"info":{"attack":7,"defense":7,"magic":4,"difficulty":3},"image":{"full":"Volibear.png","sprite":"champion5.png","group":"champion","x":240,"y":0,"w":48,"h":48},"version":"16.21.1","formulas":[{"slot":"P","variants":[{"name":"The Relentless Storm","rows":[],"damageType":"MAGIC_DAMAGE","effects":["Innate: Whenever Volibear damages at least one enemy with a basic attack or ability, he generates a stack of The Relentless Storm for 6 seconds, refreshing on subsequent damage and stacking up to 5 times. At 5 stacks, Volibear gains Lightning Claws.","The Relentless Storm: For each stack, Volibear gains 5% (+ 4% per 100 AP) bonus attack speed, up to 25% (+ 20% per 100 AP).","Lightning Claws: Volibear's claws ignite with lightning, empowering his basic attacks on-hit to deal 11 : 60 (based on level) (+ 50% AP) bonus magic damage to the target and the nearest visible enemy within 450 units of the target, chaining up to 4 subsequent targets."]}]},{"slot":"Q","variants":[{"name":"Thundering Smash","rows":[{"attribute":"Bonus Movement Speed","modifiers":[{"values":[12,16,20,24,28],"units":["%","%","%","%","%"]}]},{"attribute":"Increased Bonus Movement Speed","modifiers":[{"values":[24,32,40,48,56],"units":["%","%","%","%","%"]}]},{"attribute":"Bonus Physical Damage","modifiers":[{"values":[10,30,50,70,90],"units":["","","","",""]},{"values":[120,120,120,120,120],"units":["% bonus AD","% bonus AD","% bonus AD","% bonus AD","% bonus AD"]}]}],"damageType":"PHYSICAL_DAMAGE","effects":["If Volibear becomes immobilized or polymorphed by an enemy during Thundering Smash, the effect ends prematurely and the cooldown is reset.","Thundering Smash resets Volibear's basic attack timer."]}]},{"slot":"W","variants":[{"name":"Frenzied Maul","rows":[{"attribute":"Physical Damage","modifiers":[{"values":[5,30,55,80,105],"units":["","","","",""]},{"values":[100,100,100,100,100],"units":["% AD","% AD","% AD","% AD","% AD"]},{"values":[6,6,6,6,6],"units":["% of his bonus health","% of his bonus health","% of his bonus health","% of his bonus health","% of his bonus health"]}]},{"attribute":"Heal","modifiers":[{"values":[20,35,50,65,80],"units":["","","","",""]},{"values":[8,11,14,17,20],"units":["% of his missing health","% of his missing health","% of his missing health","% of his missing health","% of his missing health"]}]},{"attribute":"Minion Heal","modifiers":[{"values":[10,17.5,25,32.5,40],"units":["","","","",""]},{"values":[4,5.5,7,8.5,10],"units":["% of his missing health","% of his missing health","% of his missing health","% of his missing health","% of his missing health"]}]}],"damageType":"PHYSICAL_DAMAGE","effects":["Frenzied Maul applies life steal at 100% effectiveness."]}]},{"slot":"E","variants":[{"name":"Sky Splitter","rows":[{"attribute":"Magic Damage","modifiers":[{"values":[80,110,140,170,200],"units":["","","","",""]},{"values":[80,80,80,80,80],"units":["% AP","% AP","% AP","% AP","% AP"]},{"values":[11,12,13,14,15],"units":["% of target's maximum health","% of target's maximum health","% of target's maximum health","% of target's maximum health","% of target's maximum health"]}]}],"damageType":"MAGIC_DAMAGE","effects":["Active: Volibear summons a lightning bolt to strike at the target location after a 2-second delay, granting sight of the area for 1 second after the first second of the delay. If Volibear is within the strike, he gains a shield equal to 14% of his maximum health (+ 75% AP) for 3 seconds."]}]},{"slot":"R","variants":[{"name":"Stormbringer","rows":[{"attribute":"Bonus Health","modifiers":[{"values":[175,350,525],"units":["","",""]}]},{"attribute":"Physical Damage","modifiers":[{"values":[300,500,700],"units":["","",""]},{"values":[250,250,250],"units":["% bonus AD","% bonus AD","% bonus AD"]},{"values":[125,125,125],"units":["% AP","% AP